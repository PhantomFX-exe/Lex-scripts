local function CreateToggle(name, settingKey)
    local Button = Instance.new("TextButton")
    Button.Parent = MainFrame
    Button.Size = UDim2.new(1, 0, 0, 35)
    Button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.Text = name .. ": OFF"
    Button.Font = Enum.Font.SourceSans
    Button.TextSize = 16

    Button.MouseButton1Click:Connect(function()
        LexScript.Settings[settingKey] = not LexScript.Settings[settingKey]
        Button.Text = name .. (LexScript.Settings[settingKey] and ": ON" or ": OFF")
        Button.BackgroundColor3 = LexScript.Settings[settingKey] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
        
        if settingKey == "Aimbot" and not LexScript.Settings.Aimbot then
            currentTarget = nil
        end
    end)
    return Button
end

local function CreateInput(name, settingKey, defaultValue)
    local Container = Instance.new("Frame")
    Container.Parent = MainFrame
    Container.Size = UDim2.new(1, 0, 0, 35)
    Container.BackgroundTransparency = 1

    local Label = Instance.new("TextLabel")
    Label.Parent = Container
    Label.Text = name
    Label.Size = UDim2.new(0, 100, 1, 0)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Font = Enum.Font.SourceSans

    local Input = Instance.new("TextBox")
    Input.Parent = Container
    Input.Position = UDim2.new(0, 100, 0, 0)
    Input.Size = UDim2.new(0, 110, 1, 0)
    Input.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    Input.TextColor3 = Color3.fromRGB(255, 255, 255)
    Input.Text = tostring(defaultValue)
    Input.Font = Enum.Font.SourceSans

    Input.FocusLost:Connect(function()
        LexScript.Settings[settingKey] = tonumber(Input.Text) or defaultValue
    end)
end

