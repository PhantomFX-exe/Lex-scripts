        if LexScript.Settings.Jump then
            char.Humanoid.JumpPower = LexScript.Settings.JumpPowerValue
            char.Humanoid.UseJumpPower = true
        else
            char.Humanoid.JumpPower = 50
        end
    end
end)

-- Lógica de Fly Controlado por Teclado/Analógico
local bv, bg = nil, nil
game:GetService("RunService").RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if LexScript.Settings.Fly and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
        local humanoid = char.Humanoid
        local hrp = char.HumanoidRootPart
        
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = hrp
            
            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.Parent = hrp
        end
        
        bg.CFrame = Camera.CFrame
        
        -- Só aplica velocidade se o analógico/teclado se mover
        if humanoid.MoveDirection.Magnitude > 0 then
            bv.Velocity = Camera.CFrame.LookVector * LexScript.Settings.FlySpeedValue
        else
            bv.Velocity = Vector3.new(0, 0, 0)
        end
    else
        if bv then bv:Destroy() bv = nil end
        if bg then bg:Destroy() bg = nil end
    end
end)

-- Lógica de ESP (Nomes)
local espObjects = {}
game:GetService("RunService").RenderStepped:Connect(function()
    if LexScript.Settings.ESP then
        for _, player in pairs(game.Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                if not espObjects[player] then
                    local highlight = Instance.new("Highlight")
                    highlight.Parent = player.Character
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    
                    local billboard = Instance.new("BillboardGui")
                    billboard.Parent = player.Character:FindFirstChild("Head") or player.Character.HumanoidRootPart
                    billboard.Size = UDim2.new(0, 200, 0, 50)
                    billboard.AlwaysOnTop = true
                    billboard.ExtentsOffset = Vector3.new(0, 3, 0)
                    
                    local nameTag = Instance.new("TextLabel")
                    nameTag.Parent = billboard
                    nameTag.Size = UDim2.new(1, 0, 1, 0)
                    nameTag.BackgroundTransparency = 1
                    nameTag.Text = player.Name
                    nameTag.TextColor3 = Color3.fromRGB(255, 255, 255)
                    nameTag.TextStrokeTransparency = 0
                    nameTag.Font = Enum.Font.SourceSansBold
                    nameTag.TextSize = 14
                    
                    espObjects[player] = {highlight, billboard}
                end
            end
        end
    else
        for player, objs in pairs(espObjects) do
            for _, obj in pairs(objs) do if obj then obj:Destroy() end end
        end
        espObjects = {}
    end
end)

-- Validação do Alvo para Trava Fixa
local function IsValidTarget(player)
    return player 
        and player.Parent == game.Players 
        and player.Character 
        and player.Character:FindFirstChild("Head") 
        and player.Character:FindFirstChild("Humanoid") 
        and player.Character.Humanoid.Health > 0
end

-- Ângulo de Mira (Foca no jogador mais próximo do meio da tela)
local function GetPlayerClosestToCameraDirection()
    local closest = nil
    local smallestAngle = math.huge
    local cameraPosition = Camera.CFrame.Position
    local cameraDirection = Camera.CFrame.LookVector 

    for _, player in pairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer and IsValidTarget(player) then
            local targetPosition = player.Character.Head.Position
            local directionToTarget = (targetPosition - cameraPosition).Unit
            local dotProduct = cameraDirection:Dot(directionToTarget)
            
            if dotProduct > 0 then 
                local angleDifference = 1 - dotProduct 
                if angleDifference < smallestAngle then
                    smallestAngle = angleDifference
                    closest = player
                end
            end
        end
    end
    return closest
end

-- Execução do Aimbot Permanente
game:GetService("RunService").RenderStepped:Connect(function()
    if LexScript.Settings.Aimbot then
        if not currentTarget or not IsValidTarget(currentTarget) then
            currentTarget = GetPlayerClosestToCameraDirection()
        end

        if currentTarget and IsValidTarget(currentTarget) then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, currentTarget.Character.Head.Position)
            TargetLabel.Text = "Target: " .. currentTarget.Name
            TargetLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
        else
            TargetLabel.Text = "Target: Looking..."
            TargetLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    else
        currentTarget = nil 
        TargetLabel.Text = "Target: None"
        TargetLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end)
